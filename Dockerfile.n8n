FROM n8nio/n8n:1.99.1

USER root

# Install runtime tools we need (removed build dependencies since we use pre-built nodes)
RUN apk add --no-cache \
    curl \
    jq \
    openssl

# Install sqlite for database operations
RUN apk add --no-cache sqlite

# Create directories
RUN mkdir -p /data /scripts

# Copy pre-built custom nodes from host dist directories
# This replaces the complex build process with simple copying of already-built nodes
COPY ./n8n/custom-nodes/n8n-nodes-citation-gen/dist /tmp/custom-nodes/n8n-nodes-citation-gen
COPY ./n8n/custom-nodes/n8n-nodes-citationchecker/dist /tmp/custom-nodes/n8n-nodes-citationchecker
COPY ./n8n/custom-nodes/n8n-nodes-haystack/dist /tmp/custom-nodes/n8n-nodes-haystack
COPY ./n8n/custom-nodes/n8n-nodes-hierarchicalSummarization/dist /tmp/custom-nodes/n8n-nodes-hierarchicalSummarization
COPY ./n8n/custom-nodes/n8n-nodes-yake/dist /tmp/custom-nodes/n8n-nodes-yake
# Note: deepseek and unstructured not included as they failed to build locally

# Create the custom directory structure for n8n
# n8n v1.100.1 expects custom nodes in the user folder
RUN mkdir -p /data/.n8n/custom

# Store pre-built nodes in a persistent location for runtime restoration
RUN mkdir -p /usr/local/share/n8n-custom-nodes && \
    cp -r /tmp/custom-nodes/* /usr/local/share/n8n-custom-nodes/ && \
    rm -rf /tmp/custom-nodes

# Set proper ownership for all n8n directories
RUN chown -R node:node /data

# Copy helper scripts while still as root
COPY ./n8n/scripts/n8n-exec.sh /usr/local/bin/n8n-exec
COPY ./n8n/scripts/auto-setup.sh /usr/local/bin/auto-setup
COPY ./n8n/scripts/setup-credentials.sh /usr/local/bin/setup-credentials
COPY ./n8n/scripts/dev-startup.sh /usr/local/bin/dev-startup
COPY ./n8n/scripts/import-workflows.sh /usr/local/bin/import-workflows
COPY ./n8n/scripts/auto-login.sh /usr/local/bin/auto-login
RUN chmod +x /usr/local/bin/n8n-exec /usr/local/bin/auto-setup /usr/local/bin/setup-credentials /usr/local/bin/dev-startup /usr/local/bin/import-workflows /usr/local/bin/auto-login

# Also copy scripts to /scripts directory for single-startup.sh
COPY ./n8n/scripts/*.sh /scripts/
RUN chmod +x /scripts/*.sh

# Create workflows directory and copy workflow files
# Don't bake workflows into image - use mounted volume at runtime
# RUN mkdir -p /workflows
# COPY ./workflow_json/*.json /workflows/
# RUN chown -R node:node /workflows

USER node

ENV N8N_USER_FOLDER=/data
ENV NODE_PATH=/usr/local/lib/node_modules:/usr/lib/node_modules
ENV N8N_CUSTOM_EXTENSIONS=/data/.n8n/custom

# Copy the fix script and entrypoint (v2 - fixed to not exec n8n)
COPY --chown=node:node ./n8n/fix-custom-nodes.sh /fix-custom-nodes.sh
COPY --chown=node:node ./n8n/entrypoint.sh /entrypoint.sh
RUN chmod +x /fix-custom-nodes.sh /entrypoint.sh

# Use simplified entrypoint
ENTRYPOINT ["tini", "--", "/entrypoint.sh"]